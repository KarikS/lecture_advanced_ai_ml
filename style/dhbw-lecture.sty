\AtBeginLecture{%
  \begin{frame}[plain]
    \global\advance\c@lecture by -1
    \vspace*{0.2 cm}
    {\color{dhbwslate}\scriptsize\sffamily DHBW \,--\, ADVANCED AI \& ML}\\[0.1cm]
    {\Large\bfseries\inserttitle}
    \vspace*{0.02cm}

    \ifx\lecturesection\@empty\relax\else%
    {\lecturesection}%
    \fi%
    \vspace*{0.05cm}

    {\color{dhbwaccent}\rule{3cm}{1.4pt}}
    \vspace*{0.15 cm}

% NOTE: title/frame height is tighter under aspectratio=169 (paperheight
% dropped from 9.6cm to 9cm) -- spacing here is deliberately compact, and
% the titlefigure is height-capped (not just width-capped) so a portrait
% image can't blow past the frame the way width-only sizing did before.
\ifcsname learninggoals\endcsname
  {\vspace*{0.1 cm}
  \begin{minipage}{0.32\textwidth}
  \ifcsname titlefigure\endcsname
    {\begin{center}
    \begin{figure}[!b]
    \includegraphics[width=0.9\textwidth, height=0.36\paperheight, keepaspectratio]{\titlefigure}
     \ifcsname titlecaption\endcsname
     \caption*{\titlecaption}
     \fi
    \end{figure}
    \end{center}}
  \else
    $\;$
  \fi
  \end{minipage}\hfill
  \begin{minipage}{0.62\textwidth}
  \small\bfseries
  Learning goals
   \normalfont
   \scriptsize
  \vspace*{-3pt}
  \begin{itemize}
  \setlength{\itemsep}{0pt}
  \learninggoals
  \end{itemize}
  \end{minipage}}
\fi

    % \vspace*{\stretch{1}}
    % \normalsize
    % \insertshortauthor
    % \vspace*{\stretch{0.3}}
    % \insertshortsubtitle
    % \vspace*{\stretch{1}} \\
    % \normalfont
    % \insertshortinstitute
    % \vspace*{\stretch{0.3}}
    % \insertshortdate
    % \vspace*{\stretch{1}}
  \end{frame}
  \immediate\write\@auxout {\string \newlabel{lect:@@\thelecture}{{\insertframenumber}}}%
  \typeout{[LECTURE]=[\thelecture][\insertlecture][\thepage][\theframenumber]}%
  \usebackgroundtemplate{}
}

\def\endlecture{%
  \setcounter{lectureframenumber}{\insertframenumber}%
  \expandafter\addjustlectureframenumber\csname r@lect:@@\thelecture\endcsname%
  \immediate\write\@auxout {\string \newlabel{endlect:@@\thelecture}{{\thelectureframenumber}}}%
}

