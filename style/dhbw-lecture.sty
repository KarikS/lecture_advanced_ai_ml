% ------------------------------------------------------------------------
% Frame title: lecture

\defbeamertemplate*{frametitle}{lecture}[1][left]
{
  \ifbeamercolorempty[bg]{frametitle}{}{\nointerlineskip}%
  \@tempdima=\textwidth%
  \advance\@tempdima by\beamer@leftmargin%
  \advance\@tempdima by\beamer@rightmargin%
  \begin{beamercolorbox}[sep=0.2cm,#1,wd=\the\@tempdima]{frametitle}
    \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
    {\usebeamerfont{frametitle}\rule[-0.5ex]{0pt}{2.3ex}\insertframetitle\par}%
    \if@tempswa\else\vskip-.2cm\fi% set inside beamercolorbox... evil here...
  \end{beamercolorbox}%
  \vskip0.08cm%
}
% NOTE: preamble.tex overrides this template wholesale (uppercase title,
% no colored box) -- the beamercolorbox version above is unused as long
% as that override stays in place. Kept for reference / in case the
% override is ever dropped.

\def\beamer@fteright{\vskip0.35cm\advance\leftskip by 1.7cm\advance\rightskip by1.7cm}

\setbeamertemplate{frametitle continuation}[from second][{\small/~\insertcontinuationcount}]


%\useoutertheme{lmu-lecture}
% ------------------------------------------------------------------------
% Geometry
% aspectratio=169 widens paperwidth from 12.8cm to 16cm but keeps figures/tables
% sized against \textwidth -- if margins stayed at 0.8cm, \textwidth (and every
% width=N\textwidth figure) would grow ~29% while frame height only shrinks ~6%,
% pushing pictures past the bottom of the frame. Widen margins to hold \textwidth
% at its old 4:3 value (11.2cm) so existing content keeps its original size; the
% extra paper width becomes margin instead of inflating every figure.
\setbeamersize{text margin left=2.4cm,text margin right=2.4cm}

% ------------------------------------------------------------------------
% foot line

\pgfdeclarehorizontalshading{footlineshade}{4mm}{%
  color(0pt)=(black);%
  color(1.0\paperwidth)=(structure!50!black)}

% redefine \ref (it has been redefined somewhere by the beamerclass)
\def\lectureref#1{\expandafter\@setref\csname r@#1\endcsname\@firstoftwo{#1}}

% Keep legacy lecture bookkeeping available for \endlecture labels.
\newcounter{lectureframenumber}
\def\addjustlectureframenumber#1{}

\defbeamertemplate*{footline}{lecture theme}
{
  \usebeamerfont{footline} %author in head/foot}
  \leavevmode%
  \hbox{%
    \setbox\beamer@linebox=\hbox to\paperwidth{%
      \hskip 1em%
      {\usebeamercolor[fg]{author in head/foot}%
      \insertshortauthor~~\insertshortdate}\hfill%
      {\usebeamercolor[fg]{title in head/foot}%
      \inserttitle~~--~~}%
      \ifnum\c@lecture>0%
        {\usebeamercolor[fg]{section in head/foot}%
          \arabic{lecture}~~--~~}%
      \fi%
      {\usebeamercolor[fg]{framenumber in head/foot}%
        \insertframenumber~/~\inserttotalframenumber%
      }%
      \hskip 1em}%
    \ht\beamer@linebox=2.5mm%
    \dp\beamer@linebox=0pt%
    \setbox\beamer@linebox=\vbox{\box\beamer@linebox\vskip1.125ex}%
    {\color{dhbwslate}\rule[4.5mm]{\paperwidth}{0.5pt}}%
    %%
    \hskip-\paperwidth%
    \hbox{\box\beamer@linebox\hfill}}
}

